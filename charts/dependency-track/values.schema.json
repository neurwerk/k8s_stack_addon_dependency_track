{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["dependencyTrack"],
  "properties": {
    "dependencyTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiImage", "frontendImage", "toolingImage", "database", "runtimeSecret", "adminSecret", "collectorSecret", "persistence", "apiResources", "frontendResources", "bootstrapResources", "networkPolicy", "collection"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string"},
        "apiImage": {"type": "string", "pattern": "^.+:[^/@]+@sha256:[a-f0-9]{64}$"},
        "frontendImage": {"type": "string", "pattern": "^.+:[^/@]+@sha256:[a-f0-9]{64}$"},
        "toolingImage": {"type": "string", "minLength": 1},
        "runtimeSecret": {"type": "string", "minLength": 1},
        "adminSecret": {"type": "string", "minLength": 1},
        "collectorSecret": {"type": "string", "minLength": 1},
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "user", "secret", "passwordKey"],
          "properties": {
            "url": {"type": "string", "pattern": "^jdbc:postgresql://"},
            "user": {"type": "string", "minLength": 1},
            "secret": {"type": "string", "minLength": 1},
            "passwordKey": {"type": "string", "minLength": 1}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["storageClass", "size"],
          "additionalProperties": false,
          "properties": {
            "storageClass": {"type": "string"},
            "size": {"type": "string", "minLength": 1}
          }
        },
        "apiResources": {"type": "object"},
        "frontendResources": {"type": "object"},
        "bootstrapResources": {"type": "object"},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgresPodPort", "postgresPodSelector"],
          "properties": {
            "postgresPodPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "postgresPodSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
          }
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "schedule", "discoverRunningImages", "kubernetesApiCidrs", "kubernetesApiPort", "repositories", "images", "githubSecret", "registrySecret", "syftImage", "cdxgenImage", "stateSize", "workSize", "resources"],
          "properties": {
            "enabled": {"type": "boolean"},
            "schedule": {"type": "string", "minLength": 1},
            "discoverRunningImages": {"type": "boolean"},
            "kubernetesApiCidrs": {"type": "array", "items": {"type": "string", "pattern": "^.+/(32|128)$"}},
            "kubernetesApiPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "repositories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
                  "ref": {"type": "string", "minLength": 1}
                }
              }
            },
            "images": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9._:/-]+@sha256:[a-f0-9]{64}$"}},
            "githubSecret": {"type": "string"},
            "registrySecret": {"type": "string"},
            "syftImage": {"type": "string", "pattern": "^.+:[^/@]+@sha256:[a-f0-9]{64}$"},
            "cdxgenImage": {"type": "string", "pattern": "^.+:[^/@]+@sha256:[a-f0-9]{64}$"},
            "stateSize": {"type": "string", "minLength": 1},
            "workSize": {"type": "string", "minLength": 1},
            "tempSize": {"type": "string", "minLength": 1},
            "resources": {"type": "object"}
          }
        }
      }
    }
  }
}
