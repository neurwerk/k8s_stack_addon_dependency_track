{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dependencyTrack": {
      "type": "object",
      "required": ["enabled", "hostname"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"hostname": {"pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"}}}
    },
    "externalGateway": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "publicCertificates": {
      "type": "object",
      "required": ["useProduction"],
      "properties": {"useProduction": {"type": "boolean"}}
    }
  }
}
